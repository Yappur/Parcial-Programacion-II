<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Recursos\Bar Chachín en Luz Ámbar.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Recursos\Bar Chachín en Luz Ámbar.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Recursos\fondo-chachin.png" />
    <EmbeddedResource Include="Recursos\fondo-chachin.png" LogicalName="SistemaStock.Properties.Resources.fondo-chachin.png" />
  </ItemGroup>

</Project>
